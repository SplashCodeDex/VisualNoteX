{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VisualPlanX",
  "version": "1.0.0",
  "identifier": "com.dexstudios.visualplanx",
  "build": {
    "frontendDist": "../apps/web",
    "devUrl": "http://localhost:7200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "VisualPlanX - DeXStudios Enterprise Diagramming Platform",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "appx"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "shortDescription": "Enterprise-grade diagramming and whiteboarding platform by DeXStudios",
    "longDescription": "VisualPlanX is a powerful enterprise-grade diagramming and whiteboarding platform built by DeXStudios. Create stunning diagrams, mind maps, flowcharts, and more with our performance-optimized interface and advanced collaboration tools.",
    "copyright": "© 2025 DeXStudios. All rights reserved.",
    "publisherDisplayName": "DeXStudios",
    "category": "DeveloperTool",
    "resources": {
      "shortcuts": [{
        "name": "VisualPlanX",
        "description": "Launch VisualPlanX Enterprise Diagramming Platform"
      }]
    }
  },
  "plugins": {}
}